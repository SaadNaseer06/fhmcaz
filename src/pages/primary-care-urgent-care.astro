---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import HelpTrio from '../components/HelpTrio.astro';
import BlogStrip from '../components/BlogStrip.astro';
import Reviews from '../components/Reviews.astro';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL;
---

<Layout title="Primary Care & Urgent Care Services" description="Same-day primary and urgent care for families in Fountain Hills." siteMode="primary">
  <PageHero
    title="Primary Care & Urgent Care"
    subtitle="Patient-centered medical care for adults and families — same-day treatment, checkups, and preventive care."
    crumbs={[
      { label: 'Primary Care', href: '/fountain-hills-primary-care-clinic/' },
      { label: 'Primary & Urgent Care' },
    ]}
  />

  <section class="section bg-white">
    <div class="container-home max-w-3xl prose-site">
      <p>
        At Fountain Hills Primary Care and Urgent Care Clinic, we are committed to delivering high-quality, patient-centered medical care for adults and families. We provide same-day treatment for non-life-threatening illnesses and injuries, routine checkups, physicals, and preventive care — all designed for your convenience and comfort.
      </p>
      <p class="mt-4">
        Our experienced providers emphasize compassion, communication, and personalized treatment at every visit. Whether you need a walk-in appointment, ongoing primary care, or urgent attention after hours, we’re here to help keep your family healthy year round.
      </p>
      <blockquote class="mt-6 rounded-[20px] border-l-4 border-brand bg-card p-5 text-ink">
        Having a trusted primary and urgent care clinic in Fountain Hills gives our community comfort and confidence. FHMC’s team delivers compassionate, patient-centered care with warmth and professionalism.
      </blockquote>
    </div>
  </section>

  <section class="section bg-gray">
    <div class="container-home grid gap-8 md:grid-cols-2">
      <div class="rounded-[20px] border border-line bg-white p-6">
        <h2 class="text-2xl font-bold" style="font-family: var(--font-display);">Clinic Location & Contact</h2>
        <p class="mt-3 prose-site">{site.address.full}</p>
        <p class="mt-2">
          <a class="font-semibold text-brand" href={`tel:${site.phones.clinicTel}`}>Primary Care Clinic: {site.phones.clinic}</a>
        </p>
        <p class="mt-1">
          <a class="font-semibold text-brand" href={`mailto:${site.email}`}>{site.email}</a>
        </p>
        <a class="btn-cta mt-6" href={`${base}contact-us/`}>Contact Us →</a>
      </div>
      <div class="rounded-[20px] border border-line bg-white p-6">
        <h2 class="text-2xl font-bold" style="font-family: var(--font-display);">Have Additional Questions?</h2>
        <p class="mt-3 prose-site">We’re here to help with appointments, insurance questions, and urgent care needs.</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a class="btn-outline" href={`${base}billing-questions/`}>Billing & Financial Assistance</a>
          <a class="btn-outline" href={`${base}frequently-asked-questions/`}>Clinic FAQs</a>
          <a class="btn-outline" href={`${base}book-appointments/`}>Book Appointment</a>
        </div>
      </div>
    </div>
  </section>

  <Reviews />
  <HelpTrio />
  <BlogStrip />
</Layout>
