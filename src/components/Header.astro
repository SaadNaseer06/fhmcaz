---
import { nav, site, type NavItem } from '../data/site';
const base = import.meta.env.BASE_URL;

function href(path: string, external?: boolean) {
  if (external || path.startsWith('http')) return path;
  return `${base}${path.replace(/^\//, '')}`;
}

/** Normalize path for active matching (strip base + trailing slash) */
function norm(path: string) {
  let p = path.replace(/\\/g, '/');
  const b = base.replace(/\/+$/, '');
  if (b && (p === b || p.startsWith(b + '/'))) p = p.slice(b.length) || '/';
  p = p.replace(/^\/+/, '').replace(/\/+$/, '');
  return p;
}

const current = norm(Astro.url.pathname);

function isActive(item: NavItem): boolean {
  if (item.external) return false;
  const itemPath = norm(item.href);
  if (!itemPath) return !current;
  if (current === itemPath || current.startsWith(itemPath + '/')) return true;
  return (
    item.children?.some((c) => {
      const cp = norm(c.href);
      return !!cp && (current === cp || current.startsWith(cp + '/'));
    }) ?? false
  );
}

function isChildActive(childHref: string): boolean {
  const cp = norm(childHref);
  return !!cp && (current === cp || current.startsWith(cp + '/'));
}

const healthpassIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="49" height="49" viewBox="0 0 49 49" fill="none" aria-hidden="true"><circle cx="24.5" cy="24.5" r="24.5" fill="white"/><path d="M30.2267 28.96C30.2622 28.96 30.5467 28.7822 31.08 28.4267C31.6133 28.0711 31.88 27.8933 31.88 27.8933L31.4 27.2533C31.1511 26.8978 30.9111 26.5244 30.68 26.1333C30.4489 25.7422 30.28 25.3867 30.1733 25.0667C29.8533 24.0356 29.7644 23.0222 29.9067 22.0267C30.0489 21.0311 30.4222 20.1244 31.0267 19.3067L31.3467 18.88L30.1733 17.7067L29.8 17.9733C28.52 18.8622 27.1511 19.2622 25.6933 19.1733C24.2356 19.0844 22.8133 18.4889 21.4267 17.3867C21.2133 17.2089 21.0978 17.1378 21.08 17.1733C21.0622 17.2089 20.8933 17.4844 20.5733 18C20.2533 18.5156 20.0933 18.7822 20.0933 18.8C20.0933 18.8178 20.2178 18.9156 20.4667 19.0933C21.5689 19.84 22.7067 20.3289 23.88 20.56C25.0533 20.7911 26.1378 20.7289 27.1333 20.3733L27.56 20.2133L17 30.8267L18.2267 32L28.7867 21.44L28.6267 22.0267C28.3422 22.8089 28.2533 23.6533 28.36 24.56C28.4667 25.4667 28.7511 26.3822 29.2133 27.3067C29.32 27.5556 29.5067 27.8844 29.7733 28.2933C30.04 28.7022 30.1911 28.9244 30.2267 28.96Z" fill="#C0212F"/></svg>`;
---

<header class="relative z-50 bg-white">
  <!-- WP Elementor e431211: diagonal red / charcoal top bar, phones left -->
  <div
    class="text-white"
    style="background-image: linear-gradient(58deg, #C0212F 50%, #595A5C 50%);"
  >
    <div
      class="mx-auto flex max-w-[1717px] flex-wrap items-center justify-start gap-x-8 gap-y-1 px-4 py-2.5 text-sm sm:px-6 lg:px-8"
    >
      <a class="inline-flex items-center gap-2 hover:opacity-90" href={`tel:${site.phones.erTel}`}>
        <svg class="hidden h-3.5 w-3.5 fill-current sm:block" viewBox="0 0 512 512" aria-hidden="true">
          <path d="M497.39 361.8l-112-48a24 24 0 0 0-28 6.9l-49.6 60.6A370.66 370.66 0 0 1 130.6 204.11l60.6-49.6a23.94 23.94 0 0 0 6.9-28l-48-112A24.16 24.16 0 0 0 122.6.61l-104 24A24 24 0 0 0 0 48c0 256.5 207.9 464 464 464a24 24 0 0 0 23.4-18.6l24-104a24.29 24.29 0 0 0-14.01-27.6z"></path>
        </svg>
        24/7 Emergency: {site.phones.er}
      </a>
      <a class="hidden hover:opacity-90 sm:inline" href={`tel:${site.phones.clinicTel}`}>
        Medical Clinic: {site.phones.clinic}
      </a>
      <a class="hidden hover:opacity-90 md:inline" href={`tel:${site.phones.billingTel}`}>
        Billing: {site.phones.billing}
      </a>
    </div>
  </div>

  <!-- Main bar — logo | nav | search + menu + Healthpass -->
  <div class="border-b border-[#eee]">
    <div class="container-home flex items-center gap-3 py-3 lg:gap-4">
      <a href={base} class="w-[22%] min-w-[140px] shrink-0 sm:w-[26%]" aria-label={site.name}>
        <img
          src={`${base}images/FH-EmergencyRoom-Logo-ERClinic-1-1.png`}
          alt={site.name}
          class="h-auto w-full max-w-[237px]"
          width="237"
          height="69"
        />
      </a>

      <nav class="hidden flex-1 items-center justify-center xl:flex" aria-label="Main">
        {
          nav.map((item) => {
            const active = isActive(item);
            return (
              <div class="group relative">
                <a
                  href={href(item.href, item.external)}
                  class:list={[
                    'relative inline-flex items-center gap-1 px-2.5 py-2 text-[15px] font-semibold transition-colors 2xl:px-3.5 2xl:text-base',
                    active ? 'text-brand' : 'text-ink hover:text-brand',
                  ]}
                  style="font-family: var(--font-display);"
                  aria-current={active ? 'page' : undefined}
                  target={item.external ? '_blank' : undefined}
                  rel={item.external ? 'noopener' : undefined}
                >
                  {item.label}
                  {item.children && (
                    <svg class="h-3 w-3 fill-current opacity-80" viewBox="0 0 320 512" aria-hidden="true">
                      <path d="M31.3 192h257.3c17.8 0 26.7 21.5 14.1 34.1L174.1 354.8c-7.8 7.8-20.5 7.8-28.3 0L17.2 226.1C4.6 213.5 13.5 192 31.3 192z" />
                    </svg>
                  )}
                  {active && (
                    <span
                      class="absolute inset-x-2.5 bottom-0 h-[3px] bg-brand 2xl:inset-x-3.5"
                      aria-hidden="true"
                    />
                  )}
                </a>
                {item.children && (
                  <div class="invisible absolute left-0 top-full z-50 min-w-[260px] bg-white py-2 opacity-0 shadow-[0_8px_24px_rgba(0,0,0,.12)] transition group-hover:visible group-hover:opacity-100">
                    {item.children.map((child) => {
                      const childActive = isChildActive(child.href);
                      return (
                        <a
                          href={href(child.href)}
                          class:list={[
                            'block px-4 py-2.5 text-sm font-medium transition-colors',
                            childActive
                              ? 'bg-brand text-white'
                              : 'text-ink hover:bg-brand hover:text-white',
                          ]}
                          aria-current={childActive ? 'page' : undefined}
                        >
                          {child.label}
                        </a>
                      );
                    })}
                  </div>
                )}
              </div>
            );
          })
        }
      </nav>

      <div class="ml-auto flex items-center gap-2 lg:gap-3">
        <button
          type="button"
          class="inline-flex h-[38px] w-10 items-center justify-center rounded-[30px] bg-brand text-white"
          aria-label="Search"
          id="search-btn"
          data-open-search
        >
          <svg class="h-4 w-4 fill-current" viewBox="0 0 512 512" aria-hidden="true">
            <path d="M505 442.7L405.3 343c-4.5-4.5-10.6-7-17-7H372c27.6-35.3 44-79.7 44-128C416 93.1 322.9 0 208 0S0 93.1 0 208s93.1 208 208 208c48.3 0 92.7-16.4 128-44v16.3c0 6.4 2.5 12.5 7 17l99.7 99.7c9.4 9.4 24.6 9.4 33.9 0l28.3-28.3c9.4-9.4 9.4-24.6.1-34zM208 336c-70.7 0-128-57.2-128-128 0-70.7 57.2-128 128-128 70.7 0 128 57.2 128 128 0 70.7-57.2 128-128 128z" />
          </svg>
        </button>

        <!-- WP desktop hamburger opens insurance / HealthPass popup -->
        <button
          type="button"
          class="hidden items-center justify-center p-1 text-[#5D6063] lg:inline-flex"
          aria-label="Open info menu"
          data-open-notice
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="29" height="20" viewBox="0 0 29 20" fill="none" aria-hidden="true">
            <path d="M21.6592 1.39952C21.6592 1.04408 21.5148 0.721973 21.226 0.433186C20.9372 0.144396 20.5929 1.90735e-06 20.193 1.90735e-06H1.46616C1.0663 1.90735e-06 0.721972 0.144396 0.433183 0.433186C0.144394 0.721973 0 1.05519 0 1.43284C0 1.81049 0.144394 2.1437 0.433183 2.43249C0.721972 2.72128 1.0663 2.86568 1.46616 2.86568H20.193C20.5929 2.86568 20.9372 2.72128 21.226 2.43249C21.5148 2.1437 21.6592 1.79938 21.6592 1.39952ZM1.46616 8.59702H27.4572C27.857 8.59702 28.1902 8.73031 28.4568 8.99689C28.7234 9.26346 28.8567 9.59668 28.8567 9.99654C28.8567 10.3964 28.7234 10.7296 28.4568 10.9962C28.1902 11.2628 27.857 11.3961 27.4572 11.3961H1.46616C1.0663 11.3961 0.721972 11.2628 0.433183 10.9962C0.144394 10.7296 0 10.3964 0 9.99654C0 9.59668 0.144394 9.26346 0.433183 8.99689C0.721972 8.73031 1.0663 8.59702 1.46616 8.59702ZM1.46616 17.1274H14.4617C14.8615 17.1274 15.1947 17.2718 15.4613 17.5606C15.7279 17.8494 15.8612 18.1826 15.8612 18.5602C15.8612 18.9379 15.7279 19.2711 15.4613 19.5599C15.1947 19.8487 14.8615 19.9931 14.4617 19.9931H1.46616C1.0663 19.9931 0.721972 19.8487 0.433183 19.5599C0.144394 19.2711 0 18.9379 0 18.5602C0 18.1826 0.144394 17.8494 0.433183 17.5606C0.721972 17.2718 1.0663 17.1274 1.46616 17.1274Z" fill="#5D6063" />
          </svg>
        </button>

        <a
          href={site.healthpass}
          class="btn-header-cta hidden md:inline-flex"
          target="_blank"
          rel="noopener"
        >
          <span class="btn-header-cta__label">Join Healthpass</span>
          <span class="btn-header-cta__icon" set:html={healthpassIcon} />
        </a>

        <button
          type="button"
          id="nav-toggle"
          class="inline-flex items-center justify-center p-2 text-[#5D6063] xl:hidden"
          aria-expanded="false"
          aria-controls="mobile-nav"
          aria-label="Open menu"
        >
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-nav" class="hidden border-b border-[#eee] bg-white xl:hidden">
    <nav class="container-home flex flex-col gap-1 py-3" aria-label="Mobile">
      {
        nav.flatMap((item) => {
          const active = isActive(item);
          return [
            <a
              href={href(item.href, item.external)}
              class:list={[
                'rounded-lg px-3 py-2 font-semibold',
                active ? 'bg-pink text-brand' : 'text-ink hover:bg-pink hover:text-brand',
              ]}
              style="font-family: var(--font-display);"
              aria-current={active ? 'page' : undefined}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener' : undefined}
            >
              {item.label}
            </a>,
            ...(item.children?.map((child) => {
              const childActive = isChildActive(child.href);
              return (
                <a
                  href={href(child.href)}
                  class:list={[
                    'rounded-lg px-6 py-2 text-sm',
                    childActive ? 'bg-pink font-semibold text-brand' : 'text-muted hover:bg-pink',
                  ]}
                  aria-current={childActive ? 'page' : undefined}
                >
                  {child.label}
                </a>
              );
            }) ?? []),
          ];
        })
      }
      <a
        href={site.healthpass}
        class="btn-header-cta mt-2 justify-center"
        target="_blank"
        rel="noopener"
      >
        <span class="btn-header-cta__label">Join Healthpass</span>
        <span class="btn-header-cta__icon" set:html={healthpassIcon} />
      </a>
    </nav>
  </div>
</header>

<!-- Search modal (ElementsKit-style) -->
<dialog
  id="search-modal"
  class="fixed inset-0 z-[100] m-0 h-full max-h-none w-full max-w-none bg-black/70 p-0 open:flex open:items-center open:justify-center"
>
  <form method="dialog" class="absolute inset-0" aria-label="Close search"></form>
  <form
    class="relative z-10 mx-4 w-full max-w-xl rounded-lg bg-white p-4 shadow-xl"
    action={`${base}blogs/`}
    method="get"
    role="search"
  >
    <label class="sr-only" for="site-search">Search</label>
    <div class="flex gap-2">
      <input
        id="site-search"
        name="s"
        type="search"
        placeholder="Search..."
        class="min-w-0 flex-1 rounded-md border border-[#ddd] px-4 py-3 text-base outline-none focus:border-brand"
      />
      <button type="submit" class="rounded-md bg-brand px-4 text-white" aria-label="Search">
        <svg class="h-5 w-5 fill-current" viewBox="0 0 512 512" aria-hidden="true">
          <path d="M505 442.7L405.3 343c-4.5-4.5-10.6-7-17-7H372c27.6-35.3 44-79.7 44-128C416 93.1 322.9 0 208 0S0 93.1 0 208s93.1 208 208 208c48.3 0 92.7-16.4 128-44v16.3c0 6.4 2.5 12.5 7 17l99.7 99.7c9.4 9.4 24.6 9.4 33.9 0l28.3-28.3c9.4-9.4 9.4-24.6.1-34zM208 336c-70.7 0-128-57.2-128-128 0-70.7 57.2-128 128-128 70.7 0 128 57.2 128 128 0 70.7-57.2 128-128 128z" />
        </svg>
      </button>
    </div>
  </form>
</dialog>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });

  const searchModal = document.getElementById('search-modal') as HTMLDialogElement | null;
  document.querySelectorAll('[data-open-search]').forEach((btn) => {
    btn.addEventListener('click', () => searchModal?.showModal());
  });
  searchModal?.addEventListener('click', (e) => {
    if (e.target === searchModal) searchModal.close();
  });
</script>
