---
const reviews = [
  {
    name: 'Verified Patient',
    text: 'From the moment I arrived, the ER staff made me feel calm and cared for. The team was fast, professional, and compassionate.',
  },
  {
    name: 'Verified Patient',
    text: "I've come for both urgent and routine visits, and every time the staff impress me with their kindness, efficiency, and genuine care.",
  },
  {
    name: 'Verified Patient',
    text: 'The HealthPass program has truly changed my experience with healthcare — affordable, worry-free access to quality medical services.',
  },
];
---

<section class="bg-gray py-[61px] pb-[80px]">
  <div class="container-home">
    <div class="mx-auto max-w-3xl text-center">
      <span class="pill-label">Testimonials</span>
      <h2 class="section-title mt-5">Hear from the People Who Trust Us Most</h2>
      <p class="mt-3 text-lg font-semibold text-brand">Fountain Hills Emergency Room And Medical Center — 4.8★</p>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        reviews.map((r) => (
          <blockquote class="rounded-[20px] border border-line bg-white p-6 shadow-sm">
            <div class="mb-3 text-brand" aria-hidden="true">★★★★★</div>
            <p class="prose-site">“{r.text}”</p>
            <footer class="mt-4 text-sm font-semibold text-ink">— {r.name}</footer>
          </blockquote>
        ))
      }
    </div>
  </div>
</section>
