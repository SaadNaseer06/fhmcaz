---
import { site } from '../data/site';
const base = import.meta.env.BASE_URL;
---

<section class="section">
  <div class="container-home">
    <div class="grid items-center gap-10 rounded-[30px] bg-brand px-6 py-12 text-white md:grid-cols-2 md:px-12">
      <div>
        <span class="pill-label !bg-white/20 !text-white">Get In Touch</span>
        <h2 class="mt-4 text-3xl font-bold text-white md:text-4xl" style="font-family: var(--font-display);">
          We're Here to Help — 24/7
        </h2>
        <p class="mt-4 text-white/85">
          Whether you need emergency care, primary care, or billing help, our team is ready.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a class="btn-cta-white" href={`tel:${site.phones.erTel}`}>Call {site.phones.er}</a>
          <a class="btn-cta-white border-white bg-transparent text-white hover:bg-white hover:text-brand" href={`${base}contact-us/`}>
            Contact Us
          </a>
        </div>
      </div>
      <div class="space-y-4 text-white/90">
        <div>
          <p class="font-semibold">Find Us</p>
          <p>{site.address.full}</p>
        </div>
        <div>
          <p class="font-semibold">Billing</p>
          <p>
            Questions about your EOB or statement? Call
            <a class="underline" href={`tel:${site.phones.billingTel}`}>{site.phones.billing}</a>
          </p>
        </div>
        <div>
          <p class="font-semibold">Patient Portal</p>
          <p>Access lab results, visit summaries, and prescriptions anytime through our secure online Patient Portal.</p>
        </div>
      </div>
    </div>
  </div>
</section>
