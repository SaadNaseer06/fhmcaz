---
import { site } from '../data/site';
const base = import.meta.env.BASE_URL;
---

<section class="section bg-white">
  <div class="container-home">
    <div class="mb-8" data-animate>
      <span class="pill-label">Get In Touch</span>
      <h2 class="section-title mt-4">We're Here to Help — 24/7</h2>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      <article class="rounded-[20px] border border-line bg-card p-6 shadow-sm" data-animate style="--delay:0ms">
        <h3 class="text-xl font-bold text-ink" style="font-family: var(--font-display);">Find Us</h3>
        <p class="prose-site mt-3">{site.name}</p>
        <p class="prose-site mt-1">{site.address.full}</p>
        <a class="mt-4 inline-block font-semibold text-brand" href={site.maps} rel="noopener" target="_blank">
          View on Google Maps
        </a>
      </article>
      <article class="rounded-[20px] border border-line bg-card p-6 shadow-sm" data-animate style="--delay:80ms">
        <h3 class="text-xl font-bold text-ink" style="font-family: var(--font-display);">Patient Portal</h3>
        <p class="prose-site mt-3">
          Access your lab results, visit summaries, and prescriptions anytime through our secure online Patient Portal. Need help registering? Contact our team — we’ll guide you step by step.
        </p>
      </article>
      <article class="rounded-[20px] border border-line bg-card p-6 shadow-sm" data-animate style="--delay:160ms">
        <h3 class="text-xl font-bold text-ink" style="font-family: var(--font-display);">Billing Questions</h3>
        <p class="prose-site mt-3">
          For questions about your Explanation of Benefits (EOB) or billing statement, contact our billing specialists directly at
          <a class="font-semibold text-brand" href={`tel:${site.phones.billingTel}`}> {site.phones.billing}</a>
        </p>
        <a class="mt-4 inline-block font-semibold text-brand" href={`${base}billing-questions/`}>Billing FAQs</a>
      </article>
    </div>
  </div>
</section>
