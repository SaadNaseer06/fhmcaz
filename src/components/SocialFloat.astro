<aside
  class="pointer-events-none absolute inset-y-0 right-0 z-20 hidden md:flex md:w-[10%] md:min-w-[72px] md:max-w-[125px] md:items-center md:justify-center"
  aria-label="Social media"
>
  <div class="pointer-events-auto flex flex-col items-center gap-[11px]">
    {
      socials.map((s) => (
        <a
          href={s.href}
          class="inline-flex h-10 w-10 items-center justify-center rounded-[10%] bg-white text-[#A80E0E] shadow-sm transition hover:bg-black/20 hover:text-white"
          aria-label={s.label}
          target="_blank"
          rel="noopener"
        >
          <svg class="h-[18px] w-[18px] fill-current" viewBox={s.viewBox} aria-hidden="true">
            <path d={s.path} />
          </svg>
        </a>
      ))
    }
  </div>
</aside>
