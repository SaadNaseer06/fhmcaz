---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SiteNotice from '../components/SiteNotice.astro';
import { site, type SiteMode } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** ER main chrome vs Primary Care mini-site chrome (matches WP dual header/footer) */
  siteMode?: SiteMode;
}

const {
  title = site.name,
  description = 'Get fast, compassionate, and reliable 24/7 emergency and primary care in Fountain Hills, Rio Verde, Scottsdale, and surrounding communities.',
  siteMode = 'er',
} = Astro.props;

const pageTitle = title === site.name ? title : `${title} | ${site.shortName}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}images/FH-EmergencyRoom-Logo-ERClinic-1-1.png`} />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-white focus:px-3 focus:py-2"
    >
      Skip to content
    </a>
    <Header mode={siteMode} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer mode={siteMode} />
    <SiteNotice />
    <!-- LeadConnector chat (single instance) -->
    <script
      is:inline
      src="https://widgets.leadconnectorhq.com/loader.js"
      data-resources-url="https://widgets.leadconnectorhq.com/chat-widget/loader.js"
      data-widget-id="6a7e91f091912ff8be03e24e"></script>
    <script>
      const reveal = () => {
        // Only animate elements that opt in — never auto-hide whole page grids
        // (tall containers fail intersection ratio checks and stay opacity:0)
        const els = document.querySelectorAll('[data-animate]');
        if (!els.length) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          els.forEach((el) => el.classList.add('is-inview'));
          return;
        }

        const mark = (el: Element) => el.classList.add('is-inview');

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                mark(entry.target);
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0, rootMargin: '0px 0px -8% 0px' },
        );

        els.forEach((el) => {
          const rect = el.getBoundingClientRect();
          const vh = window.innerHeight || document.documentElement.clientHeight;
          // Already on screen at load — reveal immediately
          if (rect.top < vh * 0.92 && rect.bottom > 0) {
            mark(el);
          } else {
            io.observe(el);
          }
        });
      };
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', reveal);
      } else {
        reveal();
      }
    </script>
  </body>
</html>
